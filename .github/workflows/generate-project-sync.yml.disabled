# ============================================================================
# DISABLED — 2026-09-03, Sprint 1.1 document cleanup.
#
# Renamed to `.disabled` so GitHub will not parse or run it.
#
# Why:
#   1. It bot-commits to `main` on every push and fights sprint-closing pushes.
#   2. Its output is wrong. Every field below except `version` is hardcoded,
#      and it describes a product that does not exist in this repository:
#      a QR check-in / pass-generation app. Specifically wrong:
#        stack         "TypeScript / Vite / Tailwind / PDF.js"  -> Astro 5 / vanilla CSS
#        live_url      "https://pass.namka.org"                 -> eventserve.co.za
#        deploy_target "Hostinger VPS (Nginx)"                  -> HostAfrica shared cPanel
#        repo          "AliMora83/Events-Website"               -> AliMora83/event-serve
#   3. It greps `Version:` out of Master.md, which the pre-2026-09-03 Master.md
#      did not match (`**Version:** 1.0.1`), so `version` fell back to "0.0.0".
#
# The generated PROJECT-SYNC.json has been deleted alongside this.
#
# When to revisit: after v1.0, once someone has confirmed whether the
# namka-control dashboard reads PROJECT-SYNC.json or Master.md. Deleting the
# wrong one drops this project off the dashboard silently, which is why this is
# disabled rather than removed. See DOC-CLEANUP.md ruling 2.
# ============================================================================

name: Generate PROJECT-SYNC.json

on:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  generate-project-sync:
    runs-on: ubuntu-latest
    if: github.actor != 'github-actions[bot]'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Generate PROJECT-SYNC.json
        run: |
          TIMESTAMP=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
          TODAY=$(date -u '+%Y-%m-%d')
          ACTOR="${{ github.actor }}"
          COMMIT_MSG="${{ github.event.head_commit.message }}"
          SHORT_SHA="${{ github.sha }}"
          SHORT_SHA="${SHORT_SHA:0:7}"
          VERSION=$(grep -oP 'Version: \K[0-9]+\.[0-9]+\.[0-9]+' Master.md 2>/dev/null || echo "0.0.0")

          cat > PROJECT-SYNC.json << ENDJSON
          {
            "project": "Event Serve",
            "repo": "AliMora83/Events-Website",
            "branch": "main",
            "stack": "TypeScript / Vite / Tailwind / PDF.js",
            "status": "Active",
            "priority": 1,
            "priority_label": "🟢 Priority 1 — High Impact",
            "progress_percent": 30,
            "progress_label": "Pass generation active · Check-in logic in dev",
            "current_phase": "Phase 2 — Check-in Logic",
            "next_step": "QR scanner integration & Real-time check-in API",
            "blocker": null,
            "live_url": "https://pass.namka.org",
            "deploy_target": "Hostinger VPS (Nginx)",
            "agents": ["Antigravity"],
            "version": "$VERSION",
            "last_push": {
              "timestamp": "$TIMESTAMP",
              "actor": "$ACTOR",
              "commit_message": "$COMMIT_MSG",
              "sha": "$SHORT_SHA"
            },
            "last_updated": "$TODAY"
          }
          ENDJSON

          sed -i 's/^          //' PROJECT-SYNC.json
          echo "PROJECT-SYNC.json generated."

      - name: Commit PROJECT-SYNC.json
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git diff --quiet PROJECT-SYNC.json || (
            git add PROJECT-SYNC.json &&
            git commit -m "chore: update PROJECT-SYNC.json [skip ci]" &&
            git push
          )

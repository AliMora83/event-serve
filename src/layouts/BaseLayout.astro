---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Per-page OG image. Falls back to the site default. */
  ogImage?: string;
}

const { title, description, ogImage = '/og-default.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Derivatives of the client's "ES" monogram, generated from
      src/assets/brand/Events-favicon.png by scripts/generate-favicons.mjs.
      Re-run it by hand if the source mark changes — public/ bypasses
      astro:assets, so nothing regenerates these. Only the derivatives live in
      public/; the masters stay in src/assets/brand/ and are never served.
    -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script src="../scripts/motion.js"></script>
  </body>
</html>

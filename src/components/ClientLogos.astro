---
import { Image } from 'astro:assets';
import clients from '@data/clients.json';
import { clientLogos, type ClientLogoKey } from '@assets/images';
/**
 * Old build put mismatched logos on white chips against black. The first fix
 * desaturated them to a single height, which only worked for transparent
 * artwork — and none of these six files is transparent. See `.logo-tile` in
 * base.css for why the frame replaced the filter.
 *
 * Alt text is the organisation name here, unlike the /partnerships grid: these
 * logos carry the meaning themselves, with no adjacent heading to name them.
 */
---
<section class="section--tight" aria-labelledby="clients-heading">
  <div class="wrap">
    <h2 id="clients-heading" class="clients__heading">Organisations we've served</h2>
    <ul class="clients">
      {clients.map((client, i) => (
        <li data-reveal data-reveal-step={i}>
          <Image
            class="logo-tile"
            src={clientLogos[client.logo as ClientLogoKey]}
            alt={client.name}
            widths={[148, 296]}
            sizes="148px"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients__heading { text-align: center; margin-bottom: var(--space-5); }

  /*
    Centred flex-wrap rather than a grid, so a ragged final row stays centred
    under the rest. Six 148px tiles plus 24px gaps need 1008px and the content
    box is 1152px at --page-max, so they sit on one row at desktop, 4+2 at
    tablet and 2+2+2 at 375px. The tile is fixed-width, so nothing reflows
    inside it at any of those widths.
  */
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
  }

  .clients li { display: flex; }
</style>

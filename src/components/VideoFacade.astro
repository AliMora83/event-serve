---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Click-to-load YouTube. Until the visitor presses play the page loads a
 * self-hosted poster and nothing from youtube.com: the old build embedded an
 * autoplaying background iframe that pulled about 1 MB of YouTube JS on page
 * load. The embed is youtube-nocookie.com and only created on click.
 *
 * No JS dependency. The script below is a few lines of DOM, and without it
 * the button is inert, so the iframe is also reachable as a plain link.
 */
interface Props {
  videoId: string;
  /** Accessible name for both the button and the iframe. */
  title: string;
  poster: ImageMetadata;
}
const { videoId, title, poster } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
---
<div class="facade" data-video-facade data-video-id={videoId} data-video-title={title}>
  <button class="facade__btn" type="button" aria-label={`Play video: ${title}`}>
    <Image
      src={poster}
      alt=""
      widths={[480, 848]}
      sizes="(max-width: 768px) 100vw, 560px"
      loading="lazy"
    />
    <span class="facade__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
  <noscript><a href={watchUrl}>Watch on YouTube: {title}</a></noscript>
</div>

<style>
  .facade { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-md); overflow: hidden; background: var(--c-surface); }

  .facade__btn {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    padding: 0; border: 0;
    background: none; cursor: pointer;
    display: block;
  }
  .facade__btn img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .facade__play {
    position: absolute; top: 50%; left: 50%;
    width: 72px; height: 72px;
    transform: translate(-50%, -50%);
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--c-crimson);
    color: var(--c-on-crimson);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .facade__btn:hover .facade__play,
  .facade__btn:focus-visible .facade__play { background: var(--c-crimson-hover); }

  .facade :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
    facade.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = facade.dataset.videoTitle ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      facade.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

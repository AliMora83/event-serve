---
/**
 * Old build bled off both edges with no affordance that it scrolled.
 * This uses scroll-snap plus visible arrow controls and a keyboard-reachable
 * scroller.
 */
import { Image } from 'astro:assets';
import { workImages } from '@assets/images';

// NOT REAL ALT TEXT. These strings are what a screen reader announces, so
// they are user-facing, not source noise — this is the most visible unfinished
// copy on the site to anyone using assistive technology.
//
// Writing them needs the client's gallery-to-event mapping, which has been
// requested. Inventing descriptions for photographs of real events would be
// worse than an honest marker, so they carry the PLACEHOLDER token and the
// build guard in astro.config.mjs blocks any production build until they are
// replaced with real descriptions.
const slides = workImages.map((src, i) => ({
  src,
  alt: `PLACEHOLDER — event ${i + 1}`,
}));
---
<section class="section--tight highlights" aria-labelledby="work-heading">
  <div class="wrap highlights__head">
    <h2 id="work-heading">Work highlights</h2>
    <div class="highlights__controls">
      <button class="highlights__btn" data-scroll="-1" aria-label="Previous">‹</button>
      <button class="highlights__btn" data-scroll="1" aria-label="Next">›</button>
    </div>
  </div>

  <ul class="highlights__track" tabindex="0" data-highlight-track>
    {slides.map((slide) => (
      <li class="highlights__item">
        <Image
          src={slide.src}
          alt={slide.alt}
          widths={[480, 940]}
          sizes="(max-width: 768px) 80vw, 480px"
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
</section>

<style>
  /* Light ground. Was --c-crimson with white type; the heading and the arrow
     controls now carry the dark foreground instead. */
  .highlights { background: var(--c-surface-light); padding-block: var(--space-6); }

  .highlights__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .highlights__head h2 { margin: 0; color: var(--c-text-on-light); }

  .highlights__controls { display: flex; gap: var(--space-2); }

  /* --c-field-border is the token for a control boundary that must clear
     WCAG 1.4.11's 3:1 — 4.99:1 here. The old rgba(255,255,255,0.5) was a
     hardcoded value and is now invisible on this ground. */
  .highlights__btn {
    width: 40px; height: 40px;
    background: transparent;
    border: 1px solid var(--c-field-border);
    border-radius: 50%;
    color: var(--c-text-on-light);
    font-size: 1.25rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  /* Inverts rather than tinting, so hover needs no new token. */
  .highlights__btn:hover {
    background: var(--c-text-on-light);
    color: var(--c-surface-light);
  }

  .highlights__track {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .highlights__item {
    flex: 0 0 clamp(240px, 28vw, 360px);
    scroll-snap-align: start;
  }
  /* Square. object-fit: cover crops to fill rather than distorting — the
     source photographs are mixed landscape and portrait.

     height: auto is load-bearing, not tidying. <Image> emits width and
     height attributes, which the UA maps to a definite CSS height; with
     both dimensions definite, aspect-ratio is ignored entirely. That is why
     the previous `aspect-ratio: 4 / 3` never took effect and the items
     rendered at the photographs' own portrait proportions. Removing this
     line silently restores that bug. */
  .highlights__item img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  document.querySelectorAll('[data-scroll]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const track = document.querySelector('[data-highlight-track]');
      if (!track) return;
      const dir = Number((btn as HTMLElement).dataset.scroll);
      track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: 'smooth' });
    });
  });
</script>

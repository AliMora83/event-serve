---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/**
 * Full-bleed image band with transform-driven parallax.
 *
 * Used in exactly TWO places site-wide, both on the homepage: the hero and the
 * Partnerships band. Adding a third will make the effect feel decorative
 * rather than deliberate.
 *
 * The /partnerships band was cut to a solid treatment in Sprint 1.1 — see
 * SolidBand.astro. Only two photographs in src/assets/ are wide enough to back
 * a band at all, so this component should only ever receive one of those two.
 * A 900x500 source stretched full-bleed is visibly soft.
 */
interface Props {
  image: ImageMetadata;
  alt?: string;
  speed?: number;
  minHeight?: string;
}
const { image, alt = '', speed = 0.25, minHeight = '520px' } = Astro.props;
---
<section class="parallax band" data-parallax-speed={speed} style={`--band-min-h: ${minHeight}`}>
  <Image
    class="parallax__media"
    src={image}
    alt={alt}
    widths={[768, 1280, 1920]}
    width={1920}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="parallax__scrim" aria-hidden="true"></div>
  <div class="wrap band__content">
    <slot />
  </div>
</section>

<style>
  .band {
    min-height: var(--band-min-h);
    display: flex;
    align-items: center;
    padding-block: var(--section-y);
  }
  .band__content { width: 100%; }
</style>

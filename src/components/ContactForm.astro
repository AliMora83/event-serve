---
import site from '@data/site.json';
/**
 * Web3Forms. Replaces the old Netlify Forms setup, which NEVER DELIVERED a
 * message — at the time the site was hosted on Afrihost cPanel, not Netlify,
 * and Netlify Forms only works on Netlify, so every POST since January went
 * nowhere while the visitor saw a success banner.
 *
 * The site DID move to Netlify on 2026-09-08. That does not resurrect the old
 * integration and is not a reason to go back to it: Netlify Forms would need
 * the form re-declared and re-detected at build time, and Web3Forms already
 * delivers to the client's mailbox directly. Do not "simplify" this back.
 *
 * Four fixes from the old build:
 *   1. preventDefault() is called. The old handler didn't, so the native POST
 *      fired AND the success state rendered regardless of the outcome.
 *   2. Success only renders on an actual ok response. Failure tells the person
 *      to email directly.
 *   3. Contact details stay visible in both states.
 *   4. The success message uses brand crimson, not stock alert green.
 */
/*
 * Trimmed on read. A value pasted into the Netlify dashboard with a stray
 * space or newline is truthy but posts a malformed access_key, which the API
 * answers with a 400 — the same visible symptom as a key that was never
 * activated, and impossible to tell apart from the outside.
 */
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY?.trim();

/**
 * Local, deploy-preview and branch-deploy builds run keyless with the form
 * visibly disabled. The production build demands the key.
 *
 * Netlify sets CONTEXT on every build:
 *
 *   production        production branch (main)  KEY REQUIRED
 *   deploy-preview    a pull request            keyless OK, form disabled
 *   branch-deploy     any other branch          keyless OK, form disabled
 *   (unset)           local `npm run build`     keyless OK, form disabled
 *
 * This replaces a DEPLOY_ENV check that the retired FTPS workflow set by hand.
 * DEPLOY_ENV is gone: nothing sets it any more, so a rule keyed on it would be
 * permanently false and the production build would ship a dead form.
 *
 * THE CI CLAUSE IS A FAIL-CLOSED BACKSTOP AND IS DELIBERATE. On Netlify
 * CONTEXT is always set, so it never fires there; it exists to catch a build
 * in some other CI where CONTEXT is absent. It is worth the redundancy:
 * the live site spent four days serving an ENABLED form with an empty
 * access_key, which Web3Forms answers with a 200 while delivering nothing.
 * A visitor saw a success banner and the enquiry went nowhere. That silent
 * success is the exact failure this backstop exists to catch, and it is the
 * second time this project has shipped it — the Netlify Forms version ran for
 * nine months. Do not simplify this away.
 *
 * What we will not do under any configuration is render a form that posts an
 * empty OR MALFORMED access_key. When the key is missing or fails the format
 * check below there is no access_key field and no enabled control.
 */
const CONTEXT = process.env.CONTEXT ?? '';
const isCI = process.env.CI === 'true';
const requiresKey = CONTEXT === 'production' || (isCI && CONTEXT === '');

/*
 * A Web3Forms access key is a UUID. Presence alone was not enough: the old
 * Boolean() check passed any non-empty string, so a truncated or whitespace-
 * damaged key rendered an ENABLED form that posted garbage and got a 400.
 * That is the same class of failure as the empty-key incident — a form that
 * looks live and delivers nothing — so it now fails the same way a missing
 * key does, at build time, rather than in front of a visitor.
 */
const WEB3FORMS_KEY_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const keyPresent = Boolean(WEB3FORMS_KEY);
const keyWellFormed = keyPresent && WEB3FORMS_KEY_PATTERN.test(WEB3FORMS_KEY!);

const formConfigured = keyWellFormed;

if (import.meta.env.PROD && requiresKey && !formConfigured) {
  throw new Error(
    keyPresent
      ? 'PUBLIC_WEB3FORMS_KEY is set but MALFORMED for a production build ' +
        `(length ${WEB3FORMS_KEY!.length}, after trimming). A Web3Forms ` +
        'access key is a UUID: 8-4-4-4-12 hex digits. The value is most ' +
        'likely truncated, quoted, or carrying stray whitespace. A ' +
        'malformed key builds fine and then posts an access_key the API ' +
        'rejects with a 400, so the form would never deliver. Correct it ' +
        'in the Netlify site environment variables (Site configuration -> ' +
        'Environment variables), or in .env for a local build.'
      : 'PUBLIC_WEB3FORMS_KEY is not set for a production build. The ' +
        'contact form would build but never deliver. Set ' +
        'PUBLIC_WEB3FORMS_KEY in the Netlify site environment variables ' +
        '(Site configuration -> Environment variables), or in .env for a ' +
        'local build.'
  );
}

if (import.meta.env.PROD && !formConfigured) {
  console.warn(
    keyPresent
      ? '\n  ⚠  Building with a MALFORMED PUBLIC_WEB3FORMS_KEY — the ' +
        'contact form is disabled in this output.\n     The value is not ' +
        'a UUID; check for truncation or stray whitespace.\n'
      : '\n  ⚠  Building WITHOUT PUBLIC_WEB3FORMS_KEY — the contact form ' +
        'is disabled in this output.\n     Expected for a preview or a ' +
        'local build; a production deploy requires the key.\n'
  );
}

---
<div class="contact">
  <div class="contact__details">
    <h3>Talk to us</h3>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    {site.phones.map((phone) => (
      <p><a href={`tel:+27${phone.replace(/\D/g, '').slice(1)}`}>{phone}</a></p>
    ))}
    <p class="contact__cities">{site.cities.join(' · ')}</p>
  </div>

  <form class="contact__form" data-contact-form={formConfigured ? true : undefined}>
    {!formConfigured && (
      <p class="form-notice" role="status">
        <strong>This form isn't configured yet.</strong> It's switched off
        rather than pretending to send. Please email
        <a href={`mailto:${site.email}`}>{site.email}</a> or call us — the
        numbers are alongside.
      </p>
    )}
    {formConfigured && (
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
    )}
    <input type="hidden" name="subject" value="New enquiry from eventsserve.co.za" />
    <input type="hidden" name="from_name" value="Events Serve website" />
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required autocomplete="name" disabled={!formConfigured} />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" disabled={!formConfigured} />
    </div>
    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required disabled={!formConfigured}></textarea>
    </div>

    <!-- Honeypot. Must be named "botcheck" — that's Web3Forms' convention. -->
    <div class="visually-hidden" aria-hidden="true">
      <label for="botcheck">Leave this empty</label>
      <input id="botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
    </div>

    <button class="btn btn--primary" type="submit" disabled={!formConfigured}>
      {formConfigured ? 'Send message' : 'Form unavailable'}
    </button>

    <p class="form-status" role="status" data-form-status hidden></p>
  </form>
</div>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
  const status = document.querySelector('[data-form-status]') as HTMLElement | null;
  const submit = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();          // the old build's missing line
    if (!status || !submit) return;

    submit.disabled = true;
    submit.textContent = 'Sending…';
    status.hidden = true;
    status.classList.remove('is-error');

    /* Captured outside the try so the catch can report them. This handler
       used to end in a bare `catch {}`, which discarded the Error thrown two
       lines above it — and with it Web3Forms' own `message`, the only field
       that tells an unactivated key apart from an invalid or malformed one.
       The visitor-facing copy below is deliberately unchanged; this is a
       developer-visible diagnostic only. */
    let httpStatus: number | null = null;
    let apiMessage: string | null = null;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form)
      });
      httpStatus = response.status;

      /* Parsed in its own try so a non-JSON body (a gateway error page, a
         rate-limit response) is distinguishable in the console from a
         well-formed rejection, instead of both surfacing identically. */
      let result: { success?: boolean; message?: string };
      try {
        result = await response.json();
      } catch (parseError) {
        console.error(
          `[contact form] Web3Forms returned HTTP ${response.status} with a ` +
          'body that could not be parsed as JSON. This is a transport or ' +
          'gateway failure, not a rejected key.',
          parseError
        );
        throw new Error(`Unparseable response body (HTTP ${response.status})`);
      }

      apiMessage = result.message ?? null;

      if (response.ok && result.success) {
        status.textContent = "Thanks — we'll be in touch shortly.";
        form.reset();
      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch (error) {
      console.error(
        `[contact form] Submission failed. HTTP status: ${httpStatus ?? 'no response'}. ` +
        `Web3Forms message: ${apiMessage ?? 'none'}.`,
        error
      );
      status.textContent =
        "That didn't send. Please email info@eventsserve.co.za or call us instead.";
      status.classList.add('is-error');
    } finally {
      status.hidden = false;
      submit.disabled = false;
      submit.textContent = 'Send message';
    }
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-6);
    align-items: start;
  }

  @media (max-width: 768px) {
    .contact { grid-template-columns: 1fr; }
  }

  .contact__details a { color: var(--c-text-muted); text-decoration: none; }
  .contact__details a:hover { color: var(--c-crimson-text); }
  .contact__cities { color: var(--c-text-faint); font-size: var(--fs-small); }

  .field { margin-bottom: var(--space-3); }

  /* Shown only when PUBLIC_WEB3FORMS_KEY is absent — a keyless staging build.
     Deliberately prominent: a disabled form with no explanation reads as a
     bug, and the fallback contact route has to be obvious. */
  .form-notice {
    background: var(--c-surface);
    border: 1px solid var(--c-field-border);
    border-left: 3px solid var(--c-crimson);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  .form-notice strong { color: var(--c-crimson-text); }
  .form-notice a { color: var(--c-crimson-text); }

  .field input:disabled,
  .field textarea:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .field label {
    display: block;
    font-size: var(--fs-small);
    color: var(--c-text-muted);
    margin-bottom: var(--space-1);
  }

  .field input,
  .field textarea {
    width: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-field-border);
    border-radius: var(--radius-sm);
    color: var(--c-text);
    font: inherit;
    padding: var(--space-2) var(--space-3);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .field input:focus,
  .field textarea:focus { border-color: var(--c-crimson); }

  .form-status {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--c-success-bg);
    border-left: 3px solid var(--c-success-border);
    border-radius: var(--radius-sm);
    color: var(--c-success-text);
  }

  .form-status.is-error {
    border-left-color: var(--c-error-text);
    color: var(--c-error-text);
  }
</style>

---
import { Image } from 'astro:assets';
import site from '@data/site.json';
import { brand } from '@assets/images';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href="/">
      <Image src={brand.logo} alt="EventServe" width={120} height={112} densities={[1, 2]} />
    </a>

    <button
      class="header__toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="visually-hidden">Menu</span>
      <span class="header__bars" aria-hidden="true"></span>
    </button>

    <nav id="nav-menu" class="header__nav" data-nav-menu aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['header__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-hairline);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    text-decoration: none;
    font-size: var(--fs-small);
    color: var(--c-text-muted);
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }

  .header__link:hover { color: var(--c-text); }

  .header__link.is-active {
    color: var(--c-text);
    border-bottom-color: var(--c-crimson);
  }

  .header__toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }

  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-text);
    content: '';
  }
  .header__bars::before { transform: translateY(-7px); }
  .header__bars::after  { transform: translateY(5px); }

  @media (max-width: 768px) {
    .header__toggle { display: block; }

    .header__nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--c-ink);
      border-bottom: 1px solid var(--c-hairline);
      display: none;
    }
    .header__nav.is-open { display: block; }

    .header__nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-3) var(--gutter);
    }
    .header__link {
      display: block;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--c-hairline);
    }
  }
</style>

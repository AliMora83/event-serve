---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
---
<BaseLayout
  title="Contact EventServe"
  description="Get in touch with EventServe for events in Johannesburg, Cape Town, Durban and Bloemfontein."
>
  <section class="section">
    <div class="wrap">
      <h1>Contact us</h1>
      <p class="lede">
        Tell us about your event and we'll come back to you.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

---
/**
 * Minimal 404. Exists so .htaccess's `ErrorDocument 404 /404.html` resolves —
 * without it Apache serves its own bare error page.
 *
 * Deliberately unstyled beyond the tokens and free of copy. Sprint 1 builds no
 * page content; this is plumbing. Give it real wording when the voice is
 * settled.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found | EventServe"
  description="That page doesn't exist."
>
  <section class="section">
    <div class="wrap notfound">
      <p class="notfound__code">404</p>
      <h1>That page doesn't exist</h1>
      <p class="notfound__lede">
        The link may be out of date, or the page may have moved.
      </p>
      <a class="btn btn--primary" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { max-width: 48ch; }

  .notfound__code {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--c-crimson-text);
    margin-bottom: var(--space-2);
  }

  .notfound__lede {
    color: var(--c-text-muted);
    margin-bottom: var(--space-5);
  }
</style>

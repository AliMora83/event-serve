---
import BaseLayout from '@layouts/BaseLayout.astro';
import Marquee from '@components/Marquee.astro';
import StatsBand from '@components/StatsBand.astro';
import ServiceGrid from '@components/ServiceGrid.astro';
import WorkHighlights from '@components/WorkHighlights.astro';
import ClientLogos from '@components/ClientLogos.astro';
import Testimonials from '@components/Testimonials.astro';
import ParallaxBand from '@components/ParallaxBand.astro';
import SectionHeading from '@components/SectionHeading.astro';
import FeatureList from '@components/FeatureList.astro';
import VideoFacade from '@components/VideoFacade.astro';
import why from '@data/why.json';
import { heroImages, videoPoster } from '@assets/images';
---
<BaseLayout
  title="Events Serve | Event management and production across South Africa"
  description="Full-service events and media company delivering conferences, corporate events, awards, gala dinners and festivals across South Africa."
>
  <!-- HERO — parallax band 1 of 3 -->
  <ParallaxBand image={heroImages.stage} speed={0.3} minHeight="88vh">
    <p class="hero__eyebrow">Events Serve</p>
    <h1 class="hero__title">Your vision. Our expertise. One exceptional experience.</h1>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/contact">Start a conversation</a>
      <a class="btn btn--ghost" href="/services">See what we do</a>
    </div>
  </ParallaxBand>

  <Marquee text="Let’s create something memorable" />

  <StatsBand />

  <section class="section" aria-labelledby="about-heading">
    <div class="wrap intro">
      <div>
        <SectionHeading title="We do events" id="about-heading" />
        <p class="lede">
          Events Serve (Pty) Ltd is a dynamic, full-service events and media
          company dedicated to creating memorable experiences that connect
          people, brands and audiences.
        </p>
        <a class="btn btn--ghost" href="/about">More about us</a>
      </div>
      <VideoFacade
        videoId="EhmIfUMwf68"
        title="KB Motsilanyane — Rock Lefatshe, live at the SA Sports Awards 2025"
        poster={videoPoster}
      />
    </div>
  </section>

  <WorkHighlights />

  <!-- Services now has a real route at /services, in the nav, and the hero
       button points there. This section stays as the homepage summary: the
       SAME ServiceGrid without `detailed`, so it renders titles only while
       /services renders the prose. Both read services.json, so they cannot
       drift apart.

       The #services id is kept because it is a published anchor — the hero
       used to point at it. Removing it would break any external link. -->
  <section class="section" id="services">
    <div class="wrap">
      <SectionHeading title="What we offer" />
      <ServiceGrid />
    </div>
  </section>

  <section class="section section--light" aria-labelledby="why-heading">
    <div class="wrap">
      <SectionHeading title="Why Events Serve?" id="why-heading" />
      <FeatureList items={why} columns={3} />
    </div>
  </section>

  <ClientLogos />

  <Testimonials />

  <!--
    PARTNERSHIPS BAND — parallax 2 of 3.
    This replaces the old "Impact" section. The background photo is the
    SA Sport Awards, which is the exact property named in the partnerships
    copy, so the imagery earns the link. The community/impact message that
    used to live here has moved to /about.
  -->
  <ParallaxBand image={heroImages['sport-awards']} speed={0.2}>
    <div class="heading-mark">
      <svg class="heading-mark__star" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1.5l3.09 6.83 7.41.81-5.5 5.02 1.5 7.34L12 17.9l-6.5 3.6 1.5-7.34-5.5-5.02 7.41-.81z"/>
      </svg>
      <h2>Where brands meet experiences</h2>
      <span class="heading-mark__rule" aria-hidden="true"></span>
    </div>
    <p class="band__lede">
      We placed Hyundai South Africa as official vehicle sponsor of the 18th
      South African Sport Awards, and have connected brands including African
      Bank and Icebolethu Funerals with national sporting audiences.
    </p>
    <a class="btn btn--primary" href="/partnerships">Explore partnerships</a>
  </ParallaxBand>
</BaseLayout>

<style>
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-crimson-text);
    margin-bottom: var(--space-2);
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    max-width: 22ch;
    margin-bottom: var(--space-5);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  @media (max-width: 768px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
  }
  .intro .lede { margin-bottom: var(--space-5); }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .band__lede {
    color: var(--c-text);
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }
</style>

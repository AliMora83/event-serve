---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SolidBand from '@components/SolidBand.astro';
import FeatureList from '@components/FeatureList.astro';
import CtaBlock from '@components/CtaBlock.astro';
import { Image } from 'astro:assets';
import partners from '@data/partners.json';
import { pageImages, clientLogos, type ClientLogoKey } from '@assets/images';
import approach from '@data/approach.json';
---
<BaseLayout
  title="Sponsorships & Partnerships | Events Serve"
  description="Events Serve connects brands with high-impact events and audiences across South Africa, from sponsorship strategy to activation and stakeholder management."
>
  <!-- 1. PAGE HERO -->
  <section class="section page-hero">
    <div class="wrap">
      <h1>Sponsorships and partnerships</h1>
      <p class="page-hero__sub">Turning Partnerships Into Powerful Experiences</p>
    </div>
  </section>

  <!-- 2. INTRO — final doc copy, verbatim, all three paragraphs -->
  <section class="section--tight">
    <div class="wrap intro">
      <div>
        <p>
          At Events Serve, we believe the right partnership can do more than put
          a logo on an event; it can put a brand at the heart of an experience.
        </p>
        <p>
          Our Sponsorships and Partnerships offering connects brands with
          high-impact events, audiences, and platforms that align with their
          objectives. From sports and entertainment to corporate and
          community-driven experiences, we identify opportunities where brands
          can show up authentically, create meaningful engagement, and leave a
          lasting impression.
        </p>
        <p>
          We work closely with brands, event organisers and stakeholders to
          develop partnerships that deliver value on both sides—creating
          experiences that audiences remember and brands can be proud to be
          associated with.
        </p>
      </div>
      <Image
        src={pageImages['partnerships-intro']}
        alt="Rehearsal on the stage of the Hollywoodbets Super League Awards 2024, with the trophy on screen above"
        widths={[480, 900]}
        sizes="(max-width: 768px) 100vw, 480px"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 3. PARTNERSHIP EXPERIENCE -->
  <section class="section" aria-labelledby="experience-heading">
    <div class="wrap">
      <SectionHeading title="Our partnership experience" star={true} id="experience-heading" />
      <p class="lede">
        Our work has placed leading brands within some of South Africa’s most
        exciting and high-profile events and platforms.
      </p>
      <p class="lede">Among the brands and properties we have worked with are:</p>

      <ul class="partners">
        {partners.map((partner, i) => (
          <li class="partner" data-reveal data-reveal-step={i}>
            {partner.logoKey && (
              <Image
                class="logo-tile partner__logo"
                src={clientLogos[partner.logoKey as ClientLogoKey]}
                alt=""
                widths={[148, 296]}
                sizes="148px"
                loading="lazy"
              />
            )}
            <h3>{partner.name}</h3>
            <p class="partner__role">{partner.role}</p>
            <p class="partner__body">{partner.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. APPROACH — the six points as a FeatureList, on the shared light
       ground (.section--light in base.css). -->
  <section class="section section--light" aria-labelledby="approach-heading">
    <div class="wrap">
      <SectionHeading title="More than sponsorship. Strategic connection." id="approach-heading" />
      <p class="lede">
        We understand that sponsorship is not simply about financial support or
        brand visibility. It is about creating a meaningful connection between a
        brand, an event, and its audience.
      </p>
      <p class="lede">Our approach focuses on:</p>
      <FeatureList items={approach} columns={3} />
    </div>
  </section>

  <!--
    5. WHERE BRANDS MEET EXPERIENCES — solid treatment, not parallax.
    The parallax budget is TWO bands, both on the homepage. This one was cut
    because no photograph here is wide enough to back it: the best candidate
    was 900x500 behind a full-bleed band, which reads as an oversight rather
    than a choice. Restore with <ParallaxBand image={...}> if the client
    supplies original-resolution photography — and re-open the budget question
    at the same time.
  -->
  <SolidBand>
    <h2>Where brands meet experiences</h2>
    <p class="band__lede">
      From the red carpet to the sporting arena, from corporate platforms to
      community-focused initiatives, Events Serve bridges brands and experiences
      that matter.
    </p>
    <p class="band__lede">
      Whether you are looking to sponsor an established event, secure strategic
      brand partnerships, or create a bespoke activation around your brand, our
      team brings the relationships, creativity, and execution expertise to make
      it happen.
    </p>
  </SolidBand>

  <!-- 6. CTA -->
  <CtaBlock
    heading="Let’s create a partnership that matters."
    lede={['Your brand. Our platform. A shared experience.', 'Partner with Events Serve and let’s turn opportunities into experiences people remember.']}
    href="/contact"
    label="Start a conversation"
  />
</BaseLayout>

<style>
  .page-hero { padding-block: calc(var(--section-y) * 1.2) var(--space-6); }

  .page-hero__sub {
    color: var(--c-crimson-text);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  .intro img { border-radius: var(--radius-md); aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 768px) {
    .intro { grid-template-columns: 1fr; }
  }

  .partners {
    list-style: none; margin: var(--space-6) 0 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .partner {
    background: var(--c-surface);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  /* Geometry, border and background all come from `.logo-tile` in base.css —
     the homepage strip uses the same class. Only the spacing below is
     specific to sitting above a partner name. */
  .partner__logo { margin-bottom: var(--space-4); }
  .partner__role { color: var(--c-crimson-text); font-size: var(--fs-small); margin-bottom: var(--space-3); }
  .partner__body { color: var(--c-text-muted); font-size: var(--fs-small); }

  .band__lede { color: var(--c-text); max-width: 52ch; }
  .band__lede + .band__lede { margin-top: var(--space-3); }

</style>

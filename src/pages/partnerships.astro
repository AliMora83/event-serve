---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SolidBand from '@components/SolidBand.astro';
import { Image } from 'astro:assets';
import partners from '@data/partners.json';
import { pageImages, clientLogos, type ClientLogoKey } from '@assets/images';
import approach from '@data/approach.json';
---
<BaseLayout
  title="Sponsorships & Partnerships | Events Serve"
  description="Events Serve connects brands with high-impact events and audiences across South Africa, from sponsorship strategy to activation and stakeholder management."
>
  <!-- 1. PAGE HERO -->
  <section class="section page-hero">
    <div class="wrap">
      <h1>Sponsorships and partnerships</h1>
      <p class="page-hero__sub">Turning partnerships into powerful experiences</p>
    </div>
  </section>

  <!-- 2. INTRO — trimmed from three paragraphs to two -->
  <section class="section--tight">
    <div class="wrap intro">
      <div>
        <p>
          The right partnership can do more than put a logo on an event. It can
          put a brand at the heart of an experience.
        </p>
        <p>
          We connect brands with events, audiences and platforms that align with
          their objectives — from sport and entertainment to corporate and
          community-driven experiences — working with brands, organisers and
          stakeholders to build partnerships that deliver value on both sides.
        </p>
      </div>
      <Image
        src={pageImages['partnerships-intro']}
        alt="PLACEHOLDER — needs the client's gallery-to-event mapping"
        widths={[480, 900]}
        sizes="(max-width: 768px) 100vw, 480px"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 3. PARTNERSHIP EXPERIENCE -->
  <section class="section" aria-labelledby="experience-heading">
    <div class="wrap">
      <SectionHeading title="Our partnership experience" star={true} id="experience-heading" />
      <p class="lede">
        Our work has placed leading brands within some of South Africa's most
        high-profile events and platforms.
      </p>

      <!--
        THREE CARDS, ONE PROBLEM: the African Bank entry has no specifics in
        the source copy. Either get a concrete detail from the client or drop
        it to two cards and move African Bank into the logo row. Shipping an
        obviously empty third card is worse than showing two strong ones.
      -->
      <ul class="partners">
        {partners.map((partner, i) => (
          <li class="partner" data-reveal data-reveal-step={i}>
            {partner.logoKey && (
              <Image
                class="logo-tile partner__logo"
                src={clientLogos[partner.logoKey as ClientLogoKey]}
                alt=""
                widths={[148, 296]}
                sizes="148px"
                loading="lazy"
              />
            )}
            <h3>{partner.name}</h3>
            <p class="partner__role">{partner.role}</p>
            <p class="partner__body">{partner.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. APPROACH — the six points, as a grid. They're four-to-six words of
       substance each; as paragraphs they'd read as filler. -->
  <section class="section approach-section" aria-labelledby="approach-heading">
    <div class="wrap">
      <SectionHeading title="More than sponsorship" id="approach-heading" />
      <p class="lede">
        Sponsorship is not simply financial support or brand visibility. It is a
        connection between a brand, an event, and its audience.
      </p>

      <ul class="approach">
        {approach.map((item, i) => (
          <li class="approach__item" data-reveal data-reveal-step={i % 3}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!--
    5. WHERE BRANDS MEET EXPERIENCES — solid treatment, not parallax.
    The parallax budget is TWO bands, both on the homepage. This one was cut
    because no photograph here is wide enough to back it: the best candidate
    was 900x500 behind a full-bleed band, which reads as an oversight rather
    than a choice. Restore with <ParallaxBand image={...}> if the client
    supplies original-resolution photography — and re-open the budget question
    at the same time.
  -->
  <SolidBand>
    <h2>From the red carpet to the sporting arena</h2>
    <p class="band__lede">
      Whether you're sponsoring an established event, securing a strategic brand
      partnership, or building a bespoke activation, we bring the relationships,
      creativity and execution to make it happen.
    </p>
  </SolidBand>

  <!-- 6. CTA -->
  <section class="section cta">
    <div class="wrap">
      <h2>Let's create a partnership that matters</h2>
      <p class="lede">Your brand. Our platform. A shared experience.</p>
      <a class="btn btn--primary" href="/contact">Start a conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: calc(var(--section-y) * 1.2) var(--space-6); }

  .page-hero__sub {
    color: var(--c-crimson-text);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  .intro img { border-radius: var(--radius-md); aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 768px) {
    .intro { grid-template-columns: 1fr; }
  }

  .partners {
    list-style: none; margin: var(--space-6) 0 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .partner {
    background: var(--c-surface);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  /* Geometry, border and background all come from `.logo-tile` in base.css —
     the homepage strip uses the same class. Only the spacing below is
     specific to sitting above a partner name. */
  .partner__logo { margin-bottom: var(--space-4); }
  .partner__role { color: var(--c-crimson-text); font-size: var(--fs-small); margin-bottom: var(--space-3); }
  .partner__body { color: var(--c-text-muted); font-size: var(--fs-small); }

  /* Light ground, set per section as WorkHighlights and Testimonials do —
     there is no shared light-section class. Every foreground here is an
     -on-light token: --c-text-muted is 1.99:1 on this ground and
     --c-crimson-text 3.48:1, so neither may appear in this section. */
  .approach-section { background: var(--c-surface-light); }
  .approach-section .lede { color: var(--c-text-on-light-muted); }

  /* SectionHeading renders its own markup, which page-scoped styles cannot
     reach without :global(). Kept under .approach-section so the component's
     dark-ground defaults stand everywhere else. */
  .approach-section :global(.heading-mark h2) { color: var(--c-text-on-light); }
  .approach-section :global(.heading-mark__rule) { background: var(--c-crimson-on-light); }

  /* Six items, so the count is explicit: auto-fit fits as many columns as the
     container allows and landed 4 + 2. No minmax expresses "exactly three".
     Tiers match ServiceGrid's detailed grid — these items carry prose.
     Row gap is double the column step: at --space-5 the rules of one row
     nearly met the next. */
  .approach {
    list-style: none; margin: var(--space-6) 0 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
  }

  @media (max-width: 900px) {
    .approach { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .approach { grid-template-columns: 1fr; }
  }

  .approach__item {
    padding-left: var(--space-4);
    border-left: 2px solid var(--c-crimson-on-light);
  }
  .approach__item h3 { margin-bottom: var(--space-2); color: var(--c-text-on-light); }
  .approach__item p { color: var(--c-text-on-light-muted); font-size: var(--fs-small); }

  .band__lede { color: var(--c-text); max-width: 52ch; }

  .cta { text-align: center; }
  .cta .lede { margin-inline: auto; margin-bottom: var(--space-5); }
</style>

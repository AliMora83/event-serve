# EventServe — Apache / LiteSpeed (HostAfrica shared cPanel)
# Ships from public/ to public_html/ as part of dist/.
# Astro builds directory output: /about/ -> /about/index.html.

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. HTTP_HOST is preserved rather than hardcoded, so this stays
  # correct if the site is ever served from another hostname.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Deploy test directory — blocked outright
#
# Pre-cutover deploy tests land in public_html/_deploytest/, which puts a full
# duplicate of the site on the live domain. Blocked beats noindexed: it cannot
# be indexed if it cannot be fetched, and a noindex header still permits the
# fetch during exactly the window that matters.
#
# This is a rewrite rule rather than a bare `Require all denied` because this
# single file is deployed BOTH into _deploytest/ and, at cutover, into the
# document root. A bare Require would deny production too, and a path-scoped
# <If> block risks a 500 on the live site if the server build does not support
# it. Matching on REQUEST_URI is correct in either position and inert in
# production, where no such URL exists.
#
# The deploy job also appends `Require all denied` to the copy it places in
# _deploytest/. Two mechanisms, either sufficient.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/_deploytest(/|$)
  RewriteRule ^ - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Indexing
#
# There is one host. The site should be indexed, and robots.txt says so.
#
# A host-keyed X-Robots-Tag block used to live here for staging. It was removed
# when the staging subdomain was dropped — with a single host it is noise that
# implies a second environment exists. If a preview target is ever added, bring
# it back rather than relying on robots.txt: one build is promoted to live, so
# a file-based rule would be wrong on one host or need editing at promotion.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Custom 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Caching
#
# Everything Astro emits under /_astro/ is content-hashed, so it is immutable
# and safe to cache for a year. HTML is not hashed and must revalidate, or
# visitors keep a stale page after a deploy.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|avif|webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|json|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Defence in depth. Cheap, and the site takes no user data beyond the form.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
#
# LiteSpeed honours mod_deflate directives. Brotli is used when the server
# provides it; the deflate block is the fallback, not a duplicate.
# Images and fonts are already compressed — recompressing them wastes CPU.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Hygiene
# ---------------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.(env|git|DS_Store)">
  Require all denied
</FilesMatch>

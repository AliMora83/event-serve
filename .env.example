# Web3Forms access key, generated at web3forms.com against info@eventsserve.co.za
# Public client-side identifier, not a secret — but keep it out of source anyway.
PUBLIC_WEB3FORMS_KEY=

# There is no build-target variable to set here any more. DEPLOY_ENV was
# retired with the FTPS pipeline on 2026-09-08.
#
# Netlify sets CONTEXT on every build (production | deploy-preview |
# branch-deploy). The key is mandatory when CONTEXT=production and optional
# otherwise, so a local `npm run build` runs keyless with the contact form
# visibly disabled. For the deployed site, PUBLIC_WEB3FORMS_KEY is set in the
# Netlify site environment variables, not here.

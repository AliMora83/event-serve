# Web3Forms access key, generated at web3forms.com against info@eventserve.co.za
# Public client-side identifier, not a secret — but keep it out of source anyway.
PUBLIC_WEB3FORMS_KEY=

# Build target. Only `staging` permits building without a Web3Forms key, and
# the contact form then renders visibly disabled. Anything else — including
# leaving this unset — fails the production build rather than shipping a form
# that silently delivers nothing.
DEPLOY_ENV=staging

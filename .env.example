# Web3Forms access key, generated at web3forms.com against info@eventserve.co.za
# Public client-side identifier, not a secret — but keep it out of source anyway.
PUBLIC_WEB3FORMS_KEY=

# Build target. Leave UNSET for local work: the build runs keyless and the
# contact form renders visibly disabled.
#
# Set DEPLOY_ENV=production only for a build you intend to put on the live
# site — it makes PUBLIC_WEB3FORMS_KEY mandatory. This matters most for a
# manual cutover upload, where CI is not there to enforce it.
# DEPLOY_ENV=production
